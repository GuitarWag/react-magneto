{
  "name": "react-magneto",
  "version": "0.3.1",
  "description": "Drag-and-drop sticker board for React — a draggable fridge-magnet canvas with render-free dragging, layout export/import, and per-magnet layer, rotation and size.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external react,react-dom",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react",
    "react-component",
    "typescript",
    "drag-and-drop",
    "draggable",
    "drag",
    "dnd",
    "sticker",
    "stickers",
    "magnet",
    "fridge-magnet",
    "moodboard",
    "pinboard",
    "whiteboard",
    "canvas",
    "board",
    "layout",
    "headless"
  ],
  "license": "MIT",
  "author": "Wagner Silva",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuitarWag/react-magneto.git"
  },
  "homepage": "https://guitarwag.github.io/react-magneto/",
  "bugs": {
    "url": "https://github.com/GuitarWag/react-magneto/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "2.1.9",
    "happy-dom": "15.11.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "2.1.9"
  }
}
