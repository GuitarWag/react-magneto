{
  "name": "magneto",
  "version": "0.1.0",
  "description": "Draggable fridge-magnet board for React. Performant (render-free drag), headless, layout export/import.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external react,react-dom",
    "check": "node --experimental-strip-types checks.ts",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "keywords": [
    "react",
    "drag",
    "magnet",
    "sticker",
    "board",
    "layout"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
